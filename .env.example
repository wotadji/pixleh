# ===================== Base de données =====================
# PostgreSQL (recommandé) :
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/pixistudio?schema=public"
# MySQL (alternative, changer aussi provider="mysql" dans prisma/schema.prisma) :
# DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/pixistudio"
DATABASE_URL=""

# ===================== Authentification =====================
# Générer avec: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="https://votredomaine.com"

# ===================== Tâches cron (optionnel) =====================
# Clé secrète protégeant /api/cron/invoice-reminders (relances automatiques de facture à J-2/
# J-1/jour J, voir README section 8). Générer avec: openssl rand -hex 24
# Tant que cette variable n'est pas définie, la route répond 501 (relances désactivées).
CRON_SECRET=""

# ===================== Social Login (OAuth / OIDC) =====================
# Chaque fournisseur n'est activé que si SA paire client id/secret est renseignée (voir
# src/lib/auth.ts) — inutile de tous les remplir, laisser vide ceux non configurés.
#
# --- Google : console.cloud.google.com > APIs & Services > Identifiants
#   Créer un "ID client OAuth" de type "Application Web".
#   URI de redirection autorisée : {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- GitHub : github.com/settings/developers > OAuth Apps > New OAuth App
#   Authorization callback URL : {NEXTAUTH_URL}/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# --- Microsoft : entra.microsoft.com (ou portal.azure.com) > App registrations > New
#   registration. Type de compte : "Comptes dans n'importe quel annuaire organisationnel
#   et comptes Microsoft personnels" (pour accepter aussi bien outlook.com que les comptes
#   pro). Redirect URI (type "Web") : {NEXTAUTH_URL}/api/auth/callback/azure-ad
#   Le secret se génère dans "Certificates & secrets" > "New client secret".
#   AZURE_AD_TENANT_ID peut rester vide ("common" par défaut, accepte tous types de comptes).
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# --- Facebook : developers.facebook.com > Mes Apps > Créer une app > "Authentifier les
#   utilisateurs" > Facebook Login > Web. Valid OAuth Redirect URI :
#   {NEXTAUTH_URL}/api/auth/callback/facebook
#   ATTENTION : tant que l'app est en mode "Développement", seuls les comptes ajoutés comme
#   testeurs (Rôles de l'app) peuvent se connecter. Passer en mode "Live" nécessite une
#   revue Meta (App Review) une fois les infos légales de l'app complètes.
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# --- LinkedIn : www.linkedin.com/developers/apps > Create app, puis dans l'onglet
#   "Products", activer "Sign In with LinkedIn using OpenID Connect".
#   Authorized redirect URL : {NEXTAUTH_URL}/api/auth/callback/linkedin
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# --- Apple : developer.apple.com (compte Apple Developer payant, 99$/an) > Certificates,
#   Identifiers & Profiles > Identifiers > créer un "Services ID" (c'est lui le client id).
#   Configurer "Sign In with Apple" sur ce Services ID avec comme Return URL :
#   {NEXTAUTH_URL}/api/auth/callback/apple
#   APPLE_CLIENT_SECRET n'est PAS un mot de passe classique : c'est un JWT signé (ES256) à
#   générer à partir d'une clé privée .p8 téléchargée depuis "Keys" (Team ID + Key ID +
#   fichier .p8), valable au maximum 6 mois puis à régénérer. Script de génération :
#   https://bal.so/apple-gen-secret
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# ===================== Serveur de fichiers (SFTP) =====================
SFTP_HOST=""
SFTP_PORT="22"
SFTP_USERNAME=""
SFTP_PASSWORD=""
# Ou authentification par clé privée (laisser SFTP_PASSWORD vide si utilisé) :
SFTP_PRIVATE_KEY_PATH=""
# Dossier racine sur le serveur de fichiers où seront stockées les photos
SFTP_ROOT_PATH="/home/USER/pixistudio-storage"
# URL publique de base pour servir les fichiers (via /api/files ou un vhost dédié)
FILES_BASE_URL="https://votredomaine.com/api/files"

# Stockage local de secours pour le développement (utilisé si STORAGE_DRIVER=local)
STORAGE_DRIVER="sftp" # "sftp" | "local"
LOCAL_STORAGE_PATH="./storage"

# ===================== Paiements (Stripe) =====================
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ===================== Emails transactionnels (SMTP) =====================
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="pixleh <no-reply@votredomaine.com>"

# ===================== Divers =====================
APP_URL="https://votredomaine.com"
NODE_ENV="production"
PORT="3000"
