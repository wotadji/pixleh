{
  "name": "pixistudio",
  "version": "0.1.0",
  "private": true,
  "description": "Plateforme SaaS pour photographes : galeries clients, proofing, boutique, réservation, contrats et site vitrine (clone fonctionnel de Pixieset).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node server.js",
    "start:next": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:seed-plans": "tsx prisma/seedPlans.ts",
    "prisma:seed-features": "tsx prisma/seedFeatures.ts",
    "prisma:seed-marketing": "tsx prisma/seedMarketingBlocks.ts",
    "prisma:translate-marketing": "tsx prisma/translateMarketingBlocks.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@react-pdf/renderer": "^3.4.4",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "jsonwebtoken": "^9.0.2",
    "next": "14.2.15",
    "next-auth": "^4.24.8",
    "nodemailer": "^7.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.2.9",
    "react-signature-canvas": "^1.0.6",
    "sharp": "^0.33.5",
    "ssh2-sftp-client": "^11.0.0",
    "stripe": "^16.12.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.16.10",
    "@types/nodemailer": "^6.4.16",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@types/react-signature-canvas": "^1.0.5",
    "@types/ssh2-sftp-client": "^9.0.3",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.15",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
